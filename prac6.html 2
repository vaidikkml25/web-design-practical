<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Registration Form</title>

<style>
    body {
        font-family: Arial, sans-serif;
        background: linear-gradient(to right, #4facfe, #00f2fe);
        margin: 0;
        padding: 0;
    }

    .container {
        width: 400px;
        margin: 40px auto;
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.2);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
        color: #333;
    }

    fieldset {
        border: none;
        margin-bottom: 15px;
    }

    legend {
        font-weight: bold;
        color: #4facfe;
        margin-bottom: 8px;
    }

    input, select {
        width: 100%;
        padding: 8px;
        margin-top: 5px;
        margin-bottom: 10px;
        border-radius: 6px;
        border: 1px solid #ccc;
    }

    input[type="radio"],
    input[type="checkbox"] {
        width: auto;
        margin-right: 5px;
    }

    .option-group {
        margin-bottom: 10px;
    }

    input[type="submit"] {
        width: 100%;
        background: #4facfe;
        color: white;
        border: none;
        padding: 10px;
        font-size: 16px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
    }

    input[type="submit"]:hover {
        background: #007bff;
    }
</style>

</head>
<body>

<div class="container">

<h2>Scholarship / Seminar Registration</h2>

<form>

    <fieldset>
        <legend>Personal Information</legend>

        Full Name:
        <input type="text" required>

        Email:
        <input type="email" required>

        Phone Number:
        <input type="tel" required>
    </fieldset>

    <fieldset>
        <legend>Academic Details</legend>

        Select Course:
        <select required>
            <option value="">--Select--</option>
            <option>B.Tech</option>
            <option>B.Sc</option>
            <option>M.Tech</option>
            <option>M.Sc</option>
        </select>

        College Name:
        <input type="text" required>
    </fieldset>

    <fieldset>
        <legend>Gender</legend>

        <div class="option-group">
            <input type="radio" name="gender" required> Male
            <input type="radio" name="gender"> Female
            <input type="radio" name="gender"> Other
        </div>
    </fieldset>

    <fieldset>
        <legend>Areas of Interest</legend>

        <div class="option-group">
            <input type="checkbox"> Artificial Intelligence
            <input type="checkbox"> Web Development
            <input type="checkbox"> Data Science
        </div>
    </fieldset>

    <fieldset>
        <legend>Seminar Type</legend>

        <div class="option-group">
            <input type="radio" name="seminar" required> Online
            <input type="radio" name="seminar"> Offline
        </div>
    </fieldset>

    <input type="submit" value="Register">

</form>

</div>

</body>
</html>
