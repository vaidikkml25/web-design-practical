<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Advanced Registration Form</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', sans-serif;
}

body {
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #667eea, #764ba2);
}

.container {
    width: 450px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 25px;
    border-radius: 15px;
    background: rgba(255,255,255,0.1);
    backdrop-filter: blur(15px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    color: white;
}

h2 {
    text-align: center;
    margin-bottom: 15px;
}

fieldset {
    border: none;
    margin-bottom: 15px;
}

legend {
    font-weight: bold;
    color: #ffd369;
    margin-bottom: 8px;
}

input, select, textarea {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    margin-bottom: 10px;
    border-radius: 8px;
    border: none;
    background: rgba(255,255,255,0.2);
    color: white;
}

textarea {
    resize: none;
}

input:focus, select:focus, textarea:focus {
    background: rgba(255,255,255,0.3);
    transform: scale(1.02);
}

.options {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.options label {
    background: rgba(255,255,255,0.2);
    padding: 6px 10px;
    border-radius: 20px;
    cursor: pointer;
}

.btn {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(45deg, #ff9a9e, #fad0c4);
    color: black;
    font-size: 16px;
    cursor: pointer;
}

.btn:hover {
    transform: scale(1.05);
}
</style>

</head>
<body>

<div class="container">

<h2>✨ Scholarship / Seminar Form</h2>

<form>

<!-- Personal Info -->
<fieldset>
<legend>Personal Info</legend>

<input type="text" placeholder="Full Name" required>
<input type="email" placeholder="Email" required>
<input type="tel" placeholder="Phone Number" required>
<input type="date" required>
<input type="text" placeholder="City">
<input type="text" placeholder="State">
</fieldset>

<!-- Academic -->
<fieldset>
<legend>Academic Details</legend>

<select required>
<option value="">Select Course</option>
<option>B.Tech</option>
<option>B.Sc</option>
<option>M.Tech</option>
<option>M.Sc</option>
</select>

<input type="text" placeholder="College Name" required>
<input type="number" placeholder="Current CGPA / Percentage">
<input type="number" placeholder="Year of Study (1-4)">
</fieldset>

<!-- Gender -->
<fieldset>
<legend>Gender</legend>
<div class="options">
<label><input type="radio" name="g" required> Male</label>
<label><input type="radio" name="g"> Female</label>
<label><input type="radio" name="g"> Other</label>
</div>
</fieldset>

<!-- Interests -->
<fieldset>
<legend>Areas of Interest</legend>
<div class="options">
<label><input type="checkbox"> AI</label>
<label><input type="checkbox"> Web Dev</label>
<label><input type="checkbox"> Data Science</label>
<label><input type="checkbox"> Cyber Security</label>
<label><input type="checkbox"> Cloud Computing</label>
</div>
</fieldset>

<!-- Seminar -->
<fieldset>
<legend>Seminar Details</legend>
<div class="options">
<label><input type="radio" name="s" required> Online</label>
<label><input type="radio" name="s"> Offline</label>
</div>

<input type="date">
<input type="time">
</fieldset>

<!-- Extra Info -->
<fieldset>
<legend>Additional Information</legend>

<textarea rows="3" placeholder="Why do you want to join this seminar?"></textarea>
<input type="file">
</fieldset>

<!-- Terms -->
<fieldset>
<div class="options">
<label><input type="checkbox" required> I agree to terms & conditions</label>
</div>
</fieldset>

<button class="btn">🚀 Submit Registration</button>

</form>

</div>

</body>
</html>
